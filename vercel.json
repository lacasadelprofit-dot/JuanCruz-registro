{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "rewrites": [
    {
      "has": [{ "type": "host", "value": "juancruzconsciencia.lat" }],
      "source": "/(.*)",
      "destination": "/recursos_jcc.html"
    },
    {
      "has": [{ "type": "host", "value": "www.juancruzconsciencia.lat" }],
      "source": "/(.*)",
      "destination": "/recursos_jcc.html"
    },
    {
      "has": [{ "type": "host", "value": "registro.juancruzconsciencia.lat" }],
      "source": "/(.*)",
      "destination": "/registro_jcc.html"
    },
    { "source": "/(.*)", "destination": "/$1" }
  ]
}
